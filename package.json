{
  "name": "friend-toss",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "sprites": "node scripts/sprites.mjs",
    "needs": "node scripts/needs.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "solve": "SOLVE=1 vitest run --silent=false",
    "check": "npm run typecheck && npm run test",
    "difficulty": "tsx tests/difficulty.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "planck": "^1.5.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "prettier": "^3.10.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
}
